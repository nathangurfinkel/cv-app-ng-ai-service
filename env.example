# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Configuration (optional)
PINECONE_API_KEY=your_pinecone_api_key_here
MOCK_PINECONE=true

# CORS Configuration
CORS_ORIGINS=https://your-frontend-domain.com

# Debug Configuration
DEBUG=false
VERBOSE=false

# LemonSqueezy Licensing
LEMONSQUEEZY_WEBHOOK_SECRET=your_webhook_signing_secret_here

# AWS Infrastructure (for async jobs)
# For LocalStack (local development):
JOBS_TABLE_NAME=cv-builder-jobs
JOBS_QUEUE_URL=http://localhost:4566/000000000000/cv-builder-jobs-queue
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1

# For production AWS:
# JOBS_TABLE_NAME=your-dynamodb-table-name
# JOBS_QUEUE_URL=https://sqs.region.amazonaws.com/account/queue-name
# AWS_ENDPOINT_URL=  (leave empty for real AWS)
# AWS_DEFAULT_REGION=us-east-1
