{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ai: pip install (requirements.txt)",
      "type": "shell",
      "command": "python3 -m pip install -r requirements.txt",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ai: run local (uvicorn)",
      "type": "shell",
      "command": "python3 -m uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "ai: docker build (linux/amd64)",
      "type": "shell",
      "command": "docker buildx build --platform linux/amd64 --load -t cv-builder-ai-service:latest .",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "ai: deploy (Lambda container)",
      "type": "shell",
      "command": "bash ./deploy-container.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": []
    }
  ]
}


